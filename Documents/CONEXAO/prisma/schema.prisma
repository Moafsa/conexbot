generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              Tenant  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         Tenant   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id                      String              @id @default(uuid())
  name                    String?
  email                   String              @unique
  password                String?
  whatsapp                String?             @unique
  cpfCnpj                 String?
  role                    UserRole            @default(USER)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  notificationPreferences String?
  asaasApiKey             String?
  botLimit                Int                 @default(1)
  geminiApiKey            String?
  openaiApiKey            String?
  openrouterApiKey        String?
  elevenLabsApiKey        String?
  anthropicApiKey         String?
  asaasWalletId           String?
  resetToken              String?             @unique
  resetTokenExpires       DateTime?
  agencyId                String?
  dataForSeoApiKey        String?
  googleAdsCustomerId     String?
  ga4MeasurementId        String?
  ga4ApiSecret            String?
  googleAdsRefreshToken   String?
  metaAdsPixelId          String?
  semrushApiKey           String?
  metaAdsToken            String?
  metaAdsAccountId        String?
  accounts                Account[]
  agency                  Agency?             @relation("TenantAsAgency")
  appointments            Appointment[]
  bots                    Bot[]
  botMaterials            BotMaterial[]
  contacts                Contact[]
  followupRules           FollowupRule[]
  marketingCampaigns      MarketingCampaign[]
  marketingPosts          MarketingPost[]
  notifications           Notification[]
  payments                Payment[]
  sessions                Session[]
  smtpConfigs             SmtpConfig[]
  subscriptions           Subscription[]
  managedBy               Agency?             @relation("AgencyClients", fields: [agencyId], references: [id])
  usageCounter            UsageCounter?
  mlAccessToken           String?
  mlRefreshToken          String?
  mlTokenExpires          DateTime?
  mlUserId                String?
  clientAudits            ClientAudit[] @relation("ClientAudits")
  clientTasks             ClientTask[] @relation("ClientTasks")
}

model ProductMapping {
  id           String   @id @default(uuid())
  tenantId     String
  botId        String?
  wooProductId String // ID no WooCommerce
  mlItemId     String // ID no Mercado Livre (ex: MLB12345)
  lastSync     DateTime @default(now())
  syncStatus   String   @default("SUCCESS") // SUCCESS, ERROR, PENDING
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, wooProductId, mlItemId])
  @@index([tenantId])
  @@index([mlItemId])
}

model MarketingPost {
  id              String    @id @default(uuid())
  title           String?
  content         String
  imageUrl        String?
  platform        String
  status          String    @default("DRAFT")
  scheduledAt     DateTime?
  publishedAt     DateTime?
  metaMediaId     String?
  metaAdId        String?
  botId           String
  tenantId        String
  createdAt       DateTime  @default(now())
  mediaType       String    @default("IMAGE")
  shareToken      String?   @unique
  videoUrl        String?
  rejectionReason String?
  bot             Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model MarketingCampaign {
  id         String   @id @default(uuid())
  name       String
  objective  String
  budget     Float?
  status     String   @default("ACTIVE")
  externalId String?  @unique
  botId      String
  tenantId   String
  createdAt  DateTime @default(now())
  bot        Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model KeywordResearch {
  id         String   @id @default(uuid())
  keyword    String
  volume     Int?
  cpc        Float?
  difficulty Int?
  provider   String
  tenantId   String
  createdAt  DateTime @default(now())
}

model Bot {
  id                      String              @id @default(uuid())
  name                    String
  businessType            String
  voiceId                 String?
  modules                 String[]
  status                  String              @default("active")
  sessionName             String?             @unique
  address                 String?
  hours                   String?
  paymentMethods          String[]
  knowledgeBase           String?
  description             String?
  productsServices        String?
  websiteUrl              String?
  scrapedContent          String?
  lastScrapedAt           DateTime?
  enablePayments          Boolean             @default(false)
  fallbackContact         String?
  systemPrompt            String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  tenantId                String
  aiModel                 String              @default("gpt-4o-mini")
  aiProvider              String              @default("openai")
  chatwootAccountId       String?
  chatwootToken           String?
  chatwootUrl             String?
  chatwootInboxId         String?
  aiAgentStatus           String              @default("ACTIVE")
  niche                   String              @default("GENERIC")
  deliveryFeeType         String              @default("FIXED")
  deliveryFeeRules        Json?               @default("[]")
  mapboxToken             String?
  connectionStatus        String              @default("DISCONNECTED")
  webhookToken            String?
  webhookUrl              String?
  schedulingProvider      SchedulingProvider  @default(INTERNAL)
  googleRefreshToken      String?
  googleCalendarId        String?             @default("primary")
  appointmentDuration     Int                 @default(30)
  workingHours            Json?
  onboardingData          Json?
  messageBuffer           Int                 @default(1500)
  asaasApiKey             String?
  userSplitValue          Float               @default(0)
  aiDetectionAction       String              @default("PAUSE")
  enableAiDetection       Boolean             @default(false)
  handoffPause            Int                 @default(1440)
  humanTakeoverPause      Int                 @default(30)
  notifyChannels          String              @default("INTERNAL,WHATSAPP,EMAIL")
  connectToken            String?             @unique
  allowedGroups           String[]            @default([])
  groupResponseMode       String              @default("ALL")
  masterId                String?
  isWordpress             Boolean             @default(false)
  userSplitType           SplitType           @default(PERCENTAGE)
  marketingAutoGenerate   Boolean             @default(false)
  marketingBatchSize      Int                 @default(1)
  marketingFrequency      String?             @default("MANUAL")
  marketingTopic          String?
  lastMarketingGeneration DateTime?
  marketingPostInterval   Int                 @default(24)
  adsAutoOptimize         Boolean             @default(false)
  adsDailyBudget          Float               @default(0)
  adsObjective            String?             @default("ENGAGEMENT")
  appointments            Appointment[]
  master                  Bot?                @relation("BotAgents", fields: [masterId], references: [id])
  agents                  Bot[]               @relation("BotAgents")
  tenant                  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channels                BotChannel[]
  materials               BotMaterial[]
  media                   BotMedia[]
  assignedContacts        Contact[]           @relation("AssignedBot")
  contacts                Contact[]
  conversations           Conversation[]
  coupons                 Coupon[]
  crmStages               CrmStage[]
  crmPipelines            CrmPipeline[]
  crmWorkingHoursEnd      String              @default("18:00")
  followupRules           FollowupRule[]
  marketingCampaigns      MarketingCampaign[]
  marketingPosts          MarketingPost[]
  orders                  Order[]
  products                Product[]
  productCategories       ProductCategory[]
  productAddonGroups      ProductAddonGroup[]
  carts                   Cart[]
  vectorStores            VectorStore[]
  digitalOffers           DigitalOffer[]
  smtpConfigs             SmtpConfig[]
}

model BotChannel {
  id           String   @id @default(uuid())
  botId        String
  provider     String
  status       String   @default("DISCONNECTED")
  identifier   String?
  credentials  Json?
  webhookToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bot          Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([provider, identifier])
  @@index([botId])
}

model Appointment {
  id            String            @id @default(uuid())
  startTime     DateTime
  endTime       DateTime
  status        AppointmentStatus @default(PENDING)
  googleEventId String?           @unique
  botId         String
  contactId     String?
  tenantId      String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  notes         String?
  bot           Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  contact       Contact?          @relation(fields: [contactId], references: [id])
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SmtpConfig {
  id        String   @id @default(uuid())
  host      String
  port      Int
  user      String
  pass      String
  fromEmail String
  active    Boolean  @default(true)
  tenantId  String
  botId     String?
  createdAt DateTime @default(now())
  bot       Bot?     @relation(fields: [botId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model FollowupRule {
  id          String   @id @default(uuid())
  name        String
  triggerDays Int      @default(1)
  triggerType String   @default("AFTER_LAST_MESSAGE")
  message     String
  active      Boolean  @default(true)
  botId       String
  tenantId    String
  createdAt   DateTime @default(now())
  triggerUnit String   @default("DAYS")
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BotMaterial {
  id            String   @id @default(uuid())
  name          String
  type          String
  contentUrl    String
  extractedText String?
  botId         String
  tenantId      String
  createdAt     DateTime @default(now())
  bot           Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CrmPipeline {
  id            String     @id @default(uuid())
  name          String
  botId         String
  allowedAgents String[]   // Chatwoot agent emails/IDs who can see this pipeline
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  bot           Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)
  stages        CrmStage[]
}

model CrmStage {
  id          String       @id @default(uuid())
  name        String
  color       String       @default("gray")
  order       Int          @default(0)
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  botId       String
  pipelineId  String?
  contacts    Contact[]
  bot         Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  pipeline    CrmPipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([pipelineId])
}

model BotMedia {
  id            String    @id @default(uuid())
  type          String
  filename      String
  url           String
  description   String?
  extractedText String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  botId         String
  bot           Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
}

model Product {
  id            String         @id @default(uuid())
  name          String
  description   String?
  price         Float
  currency      String         @default("BRL")
  sku           String?
  stock         Int            @default(0)
  imageUrl      String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  botId         String
  salePrice     Float?
  videoUrl      String?
  iterations    Int?
  allowCoupons  Boolean        @default(true)
  externalUrl   String?
  billingPeriod BillingPeriod?
  type          ProductType    @default(SINGLE)
  categoryId    String?
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  addonGroups   ProductAddonGroup[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  bot           Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
}

model ProductCategory {
  id        String    @id @default(uuid())
  botId     String
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  products  Product[]
}

model ProductAddonGroup {
  id        String         @id @default(uuid())
  botId     String
  name      String         // e.g., "Adicionais", "Turbine seu Lanche"
  minSelect Int            @default(0)
  maxSelect Int?           // null means unlimited
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  bot       Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  addons    ProductAddon[]
  products  Product[]
}

model ProductAddon {
  id        String            @id @default(uuid())
  groupId   String
  name      String
  price     Float
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  group     ProductAddonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cartItems CartItemAddon[]
  orderItems OrderItemAddon[]
}

model Cart {
  id           String     @id @default(uuid())
  botId        String
  contactPhone String
  status       String     @default("ACTIVE") // ACTIVE, ABANDONED, COMPLETED
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        CartItem[]
  bot          Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, contactPhone])
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  unitPrice Float           // Base price at the moment of adding
  createdAt DateTime        @default(now())
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  addons    CartItemAddon[]
}

model CartItemAddon {
  id         String       @id @default(uuid())
  cartItemId String
  addonId    String
  unitPrice  Float        // Addon price at the moment of adding
  quantity   Int          @default(1)
  cartItem   CartItem     @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  addon      ProductAddon @relation(fields: [addonId], references: [id], onDelete: Cascade)
}

model OrderItemAddon {
  id          String       @id @default(uuid())
  orderItemId String
  addonId     String
  unitPrice   Float
  quantity    Int          @default(1)
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addon       ProductAddon @relation(fields: [addonId], references: [id], onDelete: Cascade)
}

model Coupon {
  id         String     @id @default(uuid())
  code       String
  type       CouponType @default(PERCENTAGE)
  value      Float
  active     Boolean    @default(true)
  botId      String
  tenantId   String
  expiresAt  DateTime?
  usageLimit Int?
  usedCount  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  bot        Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([botId, code])
  @@index([botId])
}

model Order {
  id               String      @id @default(uuid())
  status           String      @default("PENDING")
  totalAmount      Float
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  botId            String
  contactId        String
  commissionAmount Float?      @default(0)
  externalId       String?     @unique
  couponId         String?
  bot              Bot         @relation(fields: [botId], references: [id], onDelete: Cascade)
  contact          Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  coupon           Coupon?     @relation(fields: [couponId], references: [id])
  items            OrderItem[]
  driverId         String?
  driver           Contact?    @relation("DriverOrders", fields: [driverId], references: [id])
  followUpSent     Boolean     @default(false)
  followUpResponse String?

  @@index([couponId])
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int
  unitPrice Float
  orderId   String
  productId String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  addons    OrderItemAddon[]
}

model Contact {
  id               String        @id @default(uuid())
  phone            String
  name             String?
  email            String?
  company          String?
  role             String?
  needs            String?
  notes            String?
  tags             String[]
  lastActive       DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  tenantId         String
  botId            String?
  lastAiInsight    String?
  leadScore        Int           @default(0)
  sentiment        String?
  stageId          String?
  funnelStage      String        @default("LEAD")
  eventDate        DateTime?
  contactType      String        @default("CUSTOMER")
  driverStatus     String?
  dispatchKeywords String?
  activeJobs       Int           @default(0)
  assignedBotId    String?
  isBlocked        Boolean       @default(false)
  // Ad & UTM attribution — populated on first contact
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  adId             String?
  adsetId          String?
  adName           String?
  adsetName        String?
  campaignId       String?
  campaignName     String?
  entrySource      String?       // e.g. "whatsapp_ad", "organic", "webchat", "instagram_ad"
  appointments     Appointment[]
  assignedBot      Bot?          @relation("AssignedBot", fields: [assignedBotId], references: [id])
  bot              Bot?          @relation(fields: [botId], references: [id], onDelete: Cascade)
  stage            CrmStage?     @relation(fields: [stageId], references: [id])
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders           Order[]
  latitude         Float?
  longitude        Float?
  loginToken       String?       @unique
  loginTokenExpires DateTime?
  assignedOrders   Order[]       @relation("DriverOrders")

  @@unique([phone, botId])
}

model Conversation {
  id           String    @id @default(uuid())
  channel      String
  remoteId     String
  status       String    @default("open")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  botId        String
  pausedUntil  DateTime?
  // Ad attribution at conversation entry — set once when conversation is created
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  adId         String?
  adName       String?
  campaignId   String?
  campaignName String?
  entrySource  String?
  referrer     String?
  bot          Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([botId, remoteId])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  role           String
  createdAt      DateTime     @default(now())
  conversationId String
  tool_call_id   String?
  tool_calls     Json?
  inputTokens    Int?
  outputTokens   Int?
  aiProvider     String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Plan {
  id                 String           @id @default(uuid())
  name               String
  description        String?
  price              Float
  botLimit           Int              @default(1)
  messageLimit       Int              @default(5000)
  active             Boolean          @default(true)
  externalId         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  platformSplitValue Float            @default(0)
  priceQuarterly     Float?
  priceSemiannual    Float?
  priceYearly        Float?
  trialDays          Int              @default(0)
  features           Json?            @default("[]")
  postLimit          Int?             @default(0)
  type               SubscriptionType @default(PRIMARY)
  wordLimit          Int?             @default(0)
  interval           PlanInterval     @default(MONTHLY)
  platformSplitType  SplitType        @default(PERCENTAGE)
  productCatalogId   String?
  productCatalog     ProductCatalog?  @relation(fields: [productCatalogId], references: [id])
  subscriptions      Subscription[]
}

model Subscription {
  id              String             @id @default(uuid())
  gateway         String             @default("ASAAS")
  externalId      String?            @unique
  tenantId        String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  planId          String?
  type            SubscriptionType   @default(PRIMARY)
  writerPostsUsed Int                @default(0)
  writerWordsUsed Int                @default(0)
  status          SubscriptionStatus
  interval        PlanInterval       @default(MONTHLY)
  licenseKeys     LicenseKey[]
  plan            Plan?              @relation(fields: [planId], references: [id])
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
}

model Payment {
  id         String           @id @default(uuid())
  amount     Float
  gateway    String           @default("ASAAS")
  externalId String?          @unique
  invoiceUrl String?
  tenantId   String
  createdAt  DateTime         @default(now())
  type       SubscriptionType @default(PRIMARY)
  status     PaymentStatus
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model LicenseKey {
  id             String       @id @default(uuid())
  key            String       @unique
  siteUrl        String?
  status         String       @default("ACTIVE")
  subscriptionId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model UsageCounter {
  id            String   @id @default(uuid())
  messagesUsed  Int      @default(0)
  messagesLimit Int      @default(5000)
  botsUsed      Int      @default(0)
  botsLimit     Int      @default(1)
  periodStart   DateTime @default(now())
  periodEnd     DateTime
  tenantId      String   @unique
  warned100     Boolean  @default(false)
  warned90      Boolean  @default(false)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model GlobalConfig {
  id                      String   @id @default("system")
  systemName              String   @default("ConextBot")
  maintenanceMode         Boolean  @default(false)
  googleClientId          String?
  googleClientSecret      String?
  googleAdsDeveloperToken String?
  openaiApiKey            String?
  geminiApiKey            String?
  asaasApiKey             String?
  elevenLabsApiKey        String?
  updatedAt               DateTime @updatedAt
  supportEmail            String?
  supportWhatsapp         String?
  asaasWalletId           String?
  smtpFrom                String?
  smtpHost                String?
  smtpPass                String?
  smtpPort                Int?
  smtpUser                String?
  systemBotId             String?
  logoColoredUrl          String?
  logoWhiteUrl            String?
  mercadoPagoAccessToken  String?
  stripePublishableKey    String?
  stripeSecretKey         String?
  openrouterApiKey        String?
  metaAppId               String?
  mapboxToken             String?
  metaAppSecret           String?
  metaVerifyToken         String?
  metaWhatsappConfigId    String?
  platformAsaasWalletId   String?
  mlClientId              String?
  mlClientSecret          String?
  chatwootSuperAdminToken String?
  chatwootBaseUrl         String?
  anthropicApiKey         String?
}

// ─── Agency Intelligence Hub Models ───────────────────────────────────────

model AgentTemplate {
  id           String   @id @default(uuid())
  squadId      String
  squadName    String
  name         String
  role         String
  emoji        String   @default("🤖")
  systemPrompt String   @db.Text
  tasks        Json     @default("[]")
  llmProvider  String   @default("anthropic")
  llmModel     String   @default("claude-sonnet-4-5")
  isCustom     Boolean  @default(false)
  agencyId     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([squadId])
  @@index([agencyId])
}

model ClientAudit {
  id           String   @id @default(uuid())
  clientId     String
  agencyId     String
  scores       Json
  report       Json
  missions     Json     @default("[]")
  overallScore Int      @default(0)
  createdAt    DateTime @default(now())

  client       Tenant   @relation("ClientAudits", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([agencyId])
}

model ClientTask {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  squadId     String
  agentId     String
  clientId    String
  agencyId    String
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, APPROVED, COMPLETED
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Tenant   @relation("ClientTasks", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([agencyId])
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  content   String
  read      Boolean  @default(false)
  tenantId  String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Agency {
  id                      String          @id @default(uuid())
  tenantId                String          @unique
  salesVolumeCurrentMonth Float           @default(0)
  salesVolumeLifetime     Float           @default(0)
  currentFee              Float           @default(20.0)
  status                  String          @default("PENDING")
  asaasWalletId           String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  tenant                  Tenant          @relation("TenantAsAgency", fields: [tenantId], references: [id], onDelete: Cascade)
  pricing                 AgencyPricing[]
  clients                 Tenant[]        @relation("AgencyClients")
}

model ProductCatalog {
  id              String          @id @default(uuid())
  name            String          @unique
  description     String?
  minMonthlyPrice Float           @default(0)
  minSetupPrice   Float           @default(0)
  createdAt       DateTime        @default(now())
  agencyPricing   AgencyPricing[]
  plans           Plan[]
}

model AgencyPricing {
  id            String         @id @default(uuid())
  agencyId      String
  productId     String
  monthlyPrice  Float
  setupPrice    Float          @default(0)
  markupPercent Float          @default(0)
  agency        Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  product       ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([agencyId, productId])
}

model AgencyTier {
  id             String  @id @default(uuid())
  minSalesVolume Float
  feePercentage  Float
  name           String?
}

