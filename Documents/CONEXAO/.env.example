# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/conexbot

# ── Auth ─────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3004
NEXTAUTH_SECRET=your-secret-here

# ── Redis (BullMQ queue + distributed locks + buffer) ────
# docker-compose exposes Redis on 6380
REDIS_URL=redis://localhost:6380

# ── WhatsApp (WuzAPI / UZAPI) ────────────────────────────
UZAPI_URL=http://localhost:21465
UZAPI_SECRET_KEY=your-uzapi-secret

# Webhook security: set a shared secret on WuzAPI and here
# WuzAPI config: webhookToken = <same value>
UZAPI_WEBHOOK_SECRET=your-webhook-secret

# ── AI Providers ─────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AI...
OPENROUTER_API_KEY=sk-or-...

# ── Payment ──────────────────────────────────────────────
ASAAS_API_KEY=$aact_...
ASAAS_WEBHOOK_TOKEN=your-webhook-token
# ASAAS_SANDBOX=false

# ── App URL ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.yourcompany.com

# ── Storage (S3 / MinIO) ─────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=media

# ── Cron security ────────────────────────────────────────
CRON_SECRET=your-cron-secret

# ── Worker ───────────────────────────────────────────────
WORKER_CONCURRENCY=4

# ── Monitoring (optional — app works without Sentry) ─────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── OAuth ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Meta / Facebook ──────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
