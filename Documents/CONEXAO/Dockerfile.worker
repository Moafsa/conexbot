# Lightweight worker image — runs the BullMQ message-processing worker
# using tsx (TypeScript runtime) so no compilation step is needed.
FROM node:20-alpine
RUN apk add --no-cache libc6-compat ffmpeg

WORKDIR /app

# Install dependencies (including devDeps for tsx)
COPY package.json package-lock.json* ./
COPY prisma ./prisma/
RUN npm ci

# Copy application source
COPY . .

# Generate Prisma client from schema
RUN npx prisma generate

ENV NODE_ENV=production
CMD ["npx", "tsx", "src/workers/message-worker.ts"]
