  INTEREST
  CONSIDERATION
  DECISION
  ACTION
  CUSTOMER
  SUPPORT
  CHURNED
}


model VectorStore {
  id        String                       @id @default(uuid())
  content   String
  metadata  Json?
  embedding Unsupported("vector(1536)")?
  botId     String
  createdAt DateTime                     @default(now())
  bot       Bot                          @relation(fields: [botId], references: [id], onDelete: Cascade)
}

model DigitalOffer {
  id              String   @id @default(uuid())
  name            String
  niche           String
  price           Float
  originalPrice   Float?
  copy            Json?     // { headline, subheadline, bullets, scarcity, bonuses, cta }
  mockupImageUrl  String?
  salesPageHtml   String?  @db.Text
  isPublished     Boolean  @default(false)
  publicSlug      String?  @unique
  botId           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bot             Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([publicSlug])
}
